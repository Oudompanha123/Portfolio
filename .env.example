# Copy to .env.local for `npm run dev`. Never commit the real file.

# Resend API key, used by app/api/contact/route.ts to send contact-form
# messages. Get one at https://resend.com -> API Keys -> Create API Key.
# Without it the form still validates input but returns a 500 and logs
# "RESEND_API_KEY is not set" instead of sending the email.
RESEND_API_KEY=
